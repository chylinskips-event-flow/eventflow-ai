NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Monetyzacja (Faza A): "true" włącza egzekwowanie planów. Domyślnie wyłączone — pełny dostęp dla wszystkich.
BILLING_ENABLED=false

# Stripe Billing (Faza B) — klucze TESTOWE tylko w Preview/Development, server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcjonalne — tylko przy Stripe.js po stronie klienta (obecny przepływ = redirect, niepotrzebne).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# ID cen (price_…): STRIPE_PRICE_<PLAN> lub warianty _MONTHLY / _YEARLY.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
